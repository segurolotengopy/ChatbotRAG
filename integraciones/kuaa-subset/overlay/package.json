{
  "name": "kuaa-servicio",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de Kuaa (agente conversacional con RAG sobre un paquete validado), extraído de ChatbotRAG.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "construir": "tsc -b tsconfig.json",
    "tipos": "tsc -b tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "pruebas": "vitest run",
    "pruebas:cobertura": "vitest run --coverage",
    "verificar": "pnpm tipos && pnpm lint && pnpm pruebas",
    "servicio:dev": "pnpm --filter servicio run dev",
    "validar-config": "node --import tsx paquetes/nucleo/scripts/validar-configuracion.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.0",
    "mammoth": "^1.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
