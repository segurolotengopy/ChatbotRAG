# PARÁMETROS DE LA INFRAESTRUCTURA DE STAGING DE KUAA (plantilla; cero valores reales).
# Copie este archivo a `parametros.local.env` (ignorado por git, no se confirma) y reemplace
# cada marcador <...>. Los scripts de infra/ se niegan a correr si queda algún `<` en un valor.
# Aquí NO van secretos: el secreto CHATBOTRAG_CLIENTES se crea vacío y su valor (solo el
# SHA-256 del token de SeguroLoTengo) lo agrega una persona o un paso aparte.

# --- Proyecto y región ---
PROYECTO="<PROYECTO>"                       # ID del proyecto de staging de Interseguros
REGION="<REGION>"                           # p. ej. la región de Vertex AI elegida
SERVICIO="kuaa"                             # nombre del servicio de Cloud Run

# --- Artifact Registry ---
REPO_AR="<REPO_ARTIFACT_REGISTRY>"          # repositorio Docker
AR_RETENCION_ULTIMAS="10"                   # política de limpieza: últimas N versiones

# --- Buckets (nombres globales únicos; privados, acceso uniforme, versionado) ---
BUCKET_PAQUETE="${PROYECTO}-paquete"
BUCKET_BANCO="${PROYECTO}-banco"

# --- Cuentas de servicio (solo el nombre corto, sin dominio) ---
SA_EJECUCION="kuaa-ejecucion"               # corre el servicio: Vertex, sus secretos, lee buckets
SA_DESPLIEGUE="kuaa-despliegue"             # el CI: edita Cloud Run y sube la imagen; NO toca buckets
SA_CARGA="kuaa-carga"                       # quien sube paquete y banco a los buckets; NO edita Cloud Run

# --- Identidad federada (GitHub Actions, sin claves de larga vida) ---
WIF_POOL="github-kuaa"
WIF_PROVEEDOR="github"
REPO_GITHUB="<ORG>/<REPO>"                  # repositorio autorizado a desplegar (solo main y tags v*)

# --- Secret Manager ---
SECRETO_CLIENTES="CHATBOTRAG_CLIENTES"      # contenedor; el valor no pasa por estos scripts
ARCHIVO_CLIENTES_JSON=""                    # opcional: ruta a un archivo con el JSON de clientes (solo hashes);
                                            # si se define, se agrega como versión. Vacío = no se agrega nada.

# --- Cloud Run ---
MAX_INSTANCIAS="3"                          # tope exigido por el plan (§2.1, punto 7)
MIN_INSTANCIAS="0"
CPU="1"
MEMORIA="512Mi"
ACCESO_PUBLICO="si"                         # «si»: allUsers puede invocar (la autenticación es el Bearer del servicio).
                                            # «no»: ningún acceso sin IAM. Decisión de Interseguros.
IMAGEN_INICIAL="us-docker.pkg.dev/cloudrun/container/hello"  # solo para crear el servicio; el CI la reemplaza

# --- Variables del servicio (§2.1.b); no son secretos ---
APP_ENV="<APP_ENV>"                         # lo que el servicio acepte para staging con la vía de paquete validado
APP_VERSION="inicial"
PERFIL_CONOCIMIENTO="produccion"            # CHATBOTRAG_PERFIL_CONOCIMIENTO
PAQUETE_VALIDADO="activo"                   # CHATBOTRAG_PAQUETE_VALIDADO
VERSION_PAQUETE_VALIDADO=""                 # X.Y.Z; vacío hasta que se suba el paquete (bloque S5)
SHA256_MANIFIESTO_VALIDADO=""               # hex de 64; vacío hasta S5
BANCOS_JSON=""                              # JSON de CHATBOTRAG_BANCOS; vacío hasta S5 (va junto con el bucket del banco)
ENRUTADOR="apagado"                         # CHATBOTRAG_ENRUTADOR: apagado | activo | activo_fijo
