# Variables del servicio ChatbotRAG (sin valores reales). Ver CONFIGURACION.md.
PUERTO=8080
CHATBOTRAG_DIR_CONFIGURACIONES=./configuraciones
# JSON de clientes: solo SHA-256 de cada clave.
CHATBOTRAG_CLIENTES=[{"id":"local","agenteId":"segurolotengo","claveSha256":"<sha256-hex>"}]
# Desarrollo sin nube:
CHATBOTRAG_PROVEEDOR_FORZADO=simulado
CHATBOTRAG_INDICE=memoria
# PGVECTOR_URL=postgres://usuario:clave@host:5432/chatbotrag
CHATBOTRAG_LIMITE_IP_MINUTO=60
# CHATBOTRAG_HMAC_HERRAMIENTAS=<secreto>
# GCP_PROYECTO=<proyecto-gcp>
GCP_REGION=us-central1
AWS_REGION=us-east-1
