engine-strict=true
# Los scripts de instalación se controlan con onlyBuiltDependencies en pnpm-workspace.yaml.
# Cuarentena de versiones recién publicadas (semgrep
# package_managers.npm.npm-missing-minimum-release-age): 7 días, el mismo valor
# que `minimumReleaseAge: 10080` de pnpm-workspace.yaml, que es lo que rige la
# instalación real de este monorepo. Se declara también aquí para que cualquier
# uso de npm sobre este repositorio —`npm audit` en CI, una instalación
# manual— quede bajo la misma ventana y no por debajo de ella.
min-release-age=7
