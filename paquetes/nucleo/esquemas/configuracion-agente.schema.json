{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatbotrag/esquemas/configuracion-agente.schema.json",
  "title": "Configuración de agente ChatbotRAG (v1)",
  "description": "Documento JSON que describe un agente conversacional: identidad, voz, alcance, conocimiento (RAG), seguridad, herramientas, orientación, mensajes, modelo y perfiles.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,59}$"
    },
    "identidad": {
      "type": "object",
      "properties": {
        "nombreAsistente": {
          "type": "string",
          "maxLength": 60
        },
        "organizacion": {
          "type": "string",
          "maxLength": 120
        },
        "descripcion": {
          "type": "string",
          "maxLength": 400
        },
        "idioma": {
          "default": "es",
          "type": "string",
          "pattern": "^es(-[A-Z]{2})?$"
        },
        "zonaHoraria": {
          "default": "America/La_Paz",
          "type": "string",
          "pattern": "^[A-Za-z_]+\\/[A-Za-z_]+$"
        },
        "moneda": {
          "default": "BOB",
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "nombreAsistente",
        "organizacion"
      ],
      "additionalProperties": false
    },
    "voz": {
      "default": {},
      "type": "object",
      "properties": {
        "tratamiento": {
          "default": "usted",
          "type": "string",
          "enum": [
            "usted",
            "tu",
            "vos",
            "neutro"
          ]
        },
        "emojis": {
          "default": "pocos",
          "type": "string",
          "enum": [
            "ninguno",
            "pocos",
            "muchos"
          ]
        },
        "longitud": {
          "default": "breve",
          "type": "string",
          "enum": [
            "breve",
            "media",
            "amplia"
          ]
        },
        "registro": {
          "default": "formal",
          "type": "string",
          "enum": [
            "formal",
            "cercano"
          ]
        }
      },
      "additionalProperties": false
    },
    "operacion": {
      "default": {},
      "type": "object",
      "properties": {
        "estado": {
          "default": "operativo",
          "type": "string",
          "enum": [
            "operativo",
            "suspendido"
          ]
        },
        "horarios": {
          "default": {},
          "type": "object",
          "properties": {
            "lun": {
              "type": "string",
              "pattern": "^(\\d{2}:\\d{2}-\\d{2}:\\d{2}|cerrado)$"
            },
            "mar": {
              "type": "string",
              "pattern": "^(\\d{2}:\\d{2}-\\d{2}:\\d{2}|cerrado)$"
            },
            "mie": {
              "type": "string",
              "pattern": "^(\\d{2}:\\d{2}-\\d{2}:\\d{2}|cerrado)$"
            },
            "jue": {
              "type": "string",
              "pattern": "^(\\d{2}:\\d{2}-\\d{2}:\\d{2}|cerrado)$"
            },
            "vie": {
              "type": "string",
              "pattern": "^(\\d{2}:\\d{2}-\\d{2}:\\d{2}|cerrado)$"
            },
            "sab": {
              "type": "string",
              "pattern": "^(\\d{2}:\\d{2}-\\d{2}:\\d{2}|cerrado)$"
            },
            "dom": {
              "type": "string",
              "pattern": "^(\\d{2}:\\d{2}-\\d{2}:\\d{2}|cerrado)$"
            }
          },
          "additionalProperties": false
        },
        "prefijosPermitidos": {
          "default": [],
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,4}$"
          }
        },
        "contactoHumano": {
          "default": {},
          "type": "object",
          "properties": {
            "whatsapp": {
              "type": "string",
              "pattern": "^[0-9]{8,15}$"
            },
            "correo": {
              "type": "string",
              "maxLength": 254,
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "telefono": {
              "type": "string",
              "pattern": "^[0-9+ ()-]{6,24}$"
            },
            "texto": {
              "type": "string",
              "maxLength": 300
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "datos": {
      "default": {},
      "type": "object",
      "properties": {
        "direccion": {
          "type": "string",
          "maxLength": 200
        },
        "politicas": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{1,40}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 600
          }
        },
        "datosQueNoTenemos": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "hechos": {
          "default": [],
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "instruccionesExtra": {
          "type": "string",
          "maxLength": 1500
        }
      },
      "additionalProperties": false
    },
    "alcance": {
      "default": {},
      "type": "object",
      "properties": {
        "temasPermitidos": {
          "default": [],
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "temasBloqueados": {
          "default": [],
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "accionesProhibidas": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "additionalProperties": false
    },
    "conocimiento": {
      "default": {},
      "type": "object",
      "properties": {
        "modo": {
          "default": "rag",
          "type": "string",
          "enum": [
            "rag",
            "solo_prompt"
          ]
        },
        "coleccion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "topK": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "umbral": {
          "default": 0.35,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exigirRespaldo": {
          "default": true,
          "type": "boolean"
        },
        "tamanoFragmento": {
          "default": 900,
          "type": "integer",
          "minimum": 200,
          "maximum": 4000
        },
        "solapamiento": {
          "default": 120,
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "fuentes": {
          "default": [],
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
